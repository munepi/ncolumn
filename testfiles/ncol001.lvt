% Three columns: text flow, column floats, full and partial spans.
\input{regression-test}
\OMIT
\documentclass{article}
\usepackage[columns=3]{ncolumn}
\usepackage{ncol-test}
\begin{document}
\START
\OMIT
\MK{a1}\LN{30}\MK{a2}\FL{figure}[t]{20pt}\LN{60}\MK{a3}
\FL{figure*}[t]{50pt}\FL{figure*}[b]{40pt}
\LN{120}\MK{b1}
% both fit on one page: columns 1-2 at the top, 2-3 at the bottom
\FL{figure*}[span=2,at=tl]{60pt}\FL{figure*}[span=2,at=br]{60pt}
\LN{130}\MK{c1}
% tl 2 wide then tr 2 wide: column 2 is not flat, the second one waits
\FL{figure*}[span=2,at=tl]{30pt}\FL{figure*}[span=2,at=tr]{30pt}
\LN{200}\MK{d1}
% too tall for the top fraction: waits until \clearpage (float page)
\FL{figure*}[span=1,at=tr]{450pt}\LN{150}\MK{e1}
\clearpage
% with ! it is accepted
\FL{figure*}[!,span=1,at=tr]{450pt}\LN{160}\MK{f1}
\clearpage
\TIMO
\SHOWPAGES
\END
