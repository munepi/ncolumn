% Marks with three columns.
\input{regression-test}
\OMIT
\documentclass{article}
\usepackage[columns=3]{ncolumn}
\ExplSyntaxOn
\seq_new:N \g_marktest_seq
\AddToHook { shipout / before }
  {
    \seq_gput_right:Ne \g_marktest_seq
      {
        page~ \int_eval:n { \g_shipout_readonly_int + 1 } :~
        top=[ \TopMark { 2e-right } ]~
        first=[ \FirstMark { 2e-right } ]~
        last=[ \LastMark { 2e-right } ]~
        rightmark=[ \rightmark ]~
        col1=[ \LastMark [ first-column ] { 2e-right } ]~
        col3=[ \FirstMark [ last-column ] { 2e-right } ]
      }
  }
\NewDocumentCommand \SHOWMARKS { } { \seq_map_inline:Nn \g_marktest_seq { \iow_term:n {##1} } }
\ExplSyntaxOff
\begin{document}
\START
\OMIT
a\markright{A1}\newpage b\markright{B1} b\markright{B2}\newpage c\markright{C1}\newpage
d\newpage e\markright{E1}\newpage f\newpage
g\newpage h\newpage i\markright{I1}\newpage
j\newpage k\newpage l
\clearpage
\TIMO
\SHOWMARKS
\END
