%% Test support for ncolumn: records, for every shipped page, the state of
%% the package (reserved heights, placed spans, footnote reserve) and which
%% markers ended up in which column, and prints it at the end of the run.
\ProvidesExplPackage {ncol-test} {2026-11-23} {0.1} {ncolumn test support}
\NewMarkClass { ncoltest }
\seq_new:N \g__ncoltest_log_seq
\tl_new:N \l__ncoltest_tl
%% \MK{name}: a marker, \LN{n}: n lines of fixed height
\NewDocumentCommand \MK { m } { \InsertMark { ncoltest } {#1} }
\NewDocumentCommand \LN { m }
  { \prg_replicate:nn {#1} { \par \noindent \hbox_to_wd:nn { \linewidth } { \strut \hfil } } \par }
%% \FL{env}[spec]{height}: a float without caption
\NewDocumentCommand \FL { m O{} m }
  { \begin {#1} [#2] \noindent \rule { \linewidth } {#3} \end {#1} }
\cs_new_protected:Npn \__ncoltest_dump:
  {
    \tl_set:Ne \l__ncoltest_tl
      {
        page~ \int_eval:n { \g_shipout_readonly_int + 1 } :~
        N= \int_use:N \g__ncol_n_int \c_space_tl
        fnres= \dim_use:N \g__ncol_fnres_dim
      }
    \seq_gput_right:NV \g__ncoltest_log_seq \l__ncoltest_tl
    \int_step_inline:nn { \g__ncol_n_int }
      {
        \tl_set:Ne \l__ncoltest_tl
          {
            \c_space_tl \c_space_tl col~##1:~
            top= \dim_use:c { g__ncol_top_##1_dim } \c_space_tl
            bot= \dim_use:c { g__ncol_bot_##1_dim } \c_space_tl
            marks= [ \FirstMark [ mcol-##1 ] { ncoltest } ]
                   .. [ \LastMark [ mcol-##1 ] { ncoltest } ]
          }
        \seq_gput_right:NV \g__ncoltest_log_seq \l__ncoltest_tl
      }
    \seq_map_inline:Nn \g__ncol_placed_seq
      { \__ncoltest_span:nnnnnn ##1 }
  }
\cs_new_protected:Npn \__ncoltest_span:nnnnnn #1#2#3#4#5#6
  {
    \seq_gput_right:Ne \g__ncoltest_log_seq
      { \c_space_tl \c_space_tl span:~#2~from~column~#3,~#4~wide,~at~#5 }
  }
\AddToHook { shipout / before } { \__ncoltest_dump: }
\NewDocumentCommand \SHOWPAGES { }
  {
    \seq_map_inline:Nn \g__ncoltest_log_seq { \iow_term:n {##1} }
    \bool_if:NT \g__ncol_fn_rerun_bool { \iow_term:n { RERUN~NEEDED } }
  }
\AtBeginDocument { \dblfloatsep = 12pt \dbltextfloatsep = 20pt \floatsep = 12pt \textfloatsep = 20pt }
